# ============================================================
# KONFIGURASI ENVIRONMENT — KELURAHAN BORIMASUNGGU
# ------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` asli ke Git (sudah di .gitignore).
#
# Cara mendapatkan nilai:
#   Supabase Dashboard → Project Settings → API
# ============================================================

# URL project Supabase (contoh: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon/Public key Supabase (aman dipakai di front-end)
VITE_SUPABASE_ANON_KEY=
